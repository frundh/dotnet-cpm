<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Automatically include central appsettings.json for projects in src directory (including nested) -->
  <!-- Note: Content files from referenced projects will be copied to dependent projects' output directories -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true' And $(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)src'))">
    <Content Include="$(MSBuildThisFileDirectory)appsettings.json">
      <Link>appsettings.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PrivateAssets>all</PrivateAssets>
    </Content>
  </ItemGroup>

</Project>